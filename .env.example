# All optional. Copy to .env (or set in your hosting panel).

# Port for "npm start" (default 3001)
PORT=3001

# Require a PIN before anyone can open the app (leave empty for no PIN)
ACCESS_PIN=

# Force JSON-file storage instead of SQLite (normally automatic)
# STORAGE=json

# Only if the frontend is hosted on a different domain than the server:
# VITE_API_URL=https://quotes.example.com
# CORS_ORIGIN=https://your-frontend.example.com
